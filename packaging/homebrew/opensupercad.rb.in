# Homebrew cask, generated by release CI (@VERSION@ and @SHA256@ substituted).
# Install from a release:  brew install --cask ./opensupercad.rb
cask "opensupercad" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/1ARdotNO/OpenSuperCAD/releases/download/v#{version}/OpenSuperCAD-#{version}-macos-universal.dmg"
  name "OpenSuperCAD"
  desc "AI-powered, native editor for OpenSCAD"
  homepage "https://github.com/1ARdotNO/OpenSuperCAD"

  depends_on macos: ">= :big_sur"

  app "OpenSuperCAD.app"
  binary "#{appdir}/OpenSuperCAD.app/Contents/MacOS/opensupercad"
  binary "#{appdir}/OpenSuperCAD.app/Contents/MacOS/opensupercad-mcp"

  caveats <<~EOS
    OpenSuperCAD drives OpenSCAD for rendering:
      brew install --cask openscad
  EOS

  zap trash: [
    "~/Library/Application Support/OpenSuperCAD",
  ]
end
